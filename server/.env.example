# Server (Express API) — copy this file to server/.env and fill in real values.
# JWT_SECRET must be a long random string (>= 32 characters).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# The first administrator account is created from these on first run
# (i.e. when server/autozone.db does not yet exist). Choose a strong password.
ADMIN_EMAIL=admin@autozone.dz
ADMIN_PASSWORD=choose-a-strong-admin-password

# Optional: API port (defaults to 5000)
# PORT=5000
